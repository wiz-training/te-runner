{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wiz-training/te-runner/board/manifest.schema.json",
  "title": "te-runner action board manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "actions"],
  "properties": {
    "schema": {"const": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 60},
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "steps"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 40},
        "description": {"type": "string", "maxLength": 300},
        "confirm": {"type": "string", "maxLength": 200},
        "failure_hint": {"type": "string", "maxLength": 300},
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/step"}
        },
        "show": {
          "type": "array",
          "maxItems": 10,
          "items": {"$ref": "#/$defs/show"}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "argv", "timeout_s"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 80},
        "argv": {
          "type": "array",
          "minItems": 2,
          "prefixItems": [
            {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
            {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
          ],
          "items": {"type": "string", "pattern": "^[^\\n]*$"}
        },
        "timeout_s": {"type": "integer", "minimum": 1, "maximum": 900}
      }
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "as"],
      "properties": {
        "key": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "label": {"type": "string", "minLength": 1, "maxLength": 40},
        "as": {"enum": ["link", "text"]}
      }
    }
  }
}
