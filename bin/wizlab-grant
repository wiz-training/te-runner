#!/bin/bash
# Run from a lab's setup exec, as root, with the operator secrets in THIS process's environment (the
# exec's own `environment` map): snapshots them to a 0600 file and lists the `<noun> <verb>` pairs the
# learner shell may run through `wizlab-learner`. The container env carries no secret, so this
# snapshot is the only place the learner-side wrapper can find one. The lease credentials are
# snapshotted too: sudo's env_reset strips the caller's AWS_*/GOOGLE_*/ARM_* before the wrapper runs,
# and a wizlab verb that shells out to the CSP CLI then fails NoRegion.
#   wizlab-grant "k8sconnector ensure" "container inspect"
set -eu
[ "$#" -ge 1 ] || { echo "usage: wizlab-grant '<noun> <verb>' ..." >&2; exit 2; }
install -d -m 700 /run/lab
umask 077
: > /run/lab/wiz.env
# NUL-delimited, so a value carrying a newline (a GOOGLE_CREDENTIALS key) survives whole; `%q` re-quotes
# it for the wrapper's `.`. The names are every one wizlab reads through core._tenant_env plus the
# session, lease and Keycloak inputs — a verb granted here fails 3 if its name is missing below.
while IFS= read -r -d '' kv; do
  k=${kv%%=*}
  case "$k" in
    WIZ_TENANT|INSTRUQT_SESSION_ID|WIZLAB_SESSION_PREFIX|WIZ_CLIENT_ID|WIZ_CLIENT_SECRET) ;;
    WIZ_*_CLIENT_ID|WIZ_*_CLIENT_SECRET|WIZ_*_AZURE_APP_OBJECT_ID|WIZ_*_LOGIN_URL) ;;
    LAB_KEYCLOAK_*|GIT_CONFIG_*|ARM_*|GOOGLE_CREDENTIALS|GOOGLE_PROJECT) ;;
    AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY|AWS_SESSION_TOKEN|AWS_DEFAULT_REGION|AWS_ACCOUNT_ID) ;;
    *) continue ;;
  esac
  printf '%s=%q\n' "$k" "${kv#*=}" >> /run/lab/wiz.env
done < <(env -0)
printf '%s\n' "$@" > /run/lab/learner-verbs
n=$(grep -c -E '^WIZ_([A-Z0-9_]+_)?CLIENT_ID=' /run/lab/wiz.env || true)
[ "$n" -ge 1 ] || echo "wizlab-grant: no WIZ_<TENANT>_CLIENT_ID in this exec's environment; the learner wrapper will exit 3" >&2
echo "granted $# verb pair(s) to the learner shell; snapshot holds $(wc -l < /run/lab/wiz.env) variable(s)"
